# =====================================================================
# Astra SIEM & SOAR - Environment Configuration Template
# =====================================================================

# Enable Standalone Demo Mode (mocks SSH, Kafka, Easy-RSA, and Systemd)
# Set to 'False' only when deployed with live Kafka broker and network sensors.
DEMO_MODE=True

# Application Metadata
PROJECT_NAME="SIEM & SOAR Master API"
VERSION="4.0 (Enterprise)"

# Message Broker (used when DEMO_MODE=False)
KAFKA_BROKER=10.0.0.10:9092

# Visualization Engine (Kibana Discover URL for alert investigation pivoting)
KIBANA_URL=http://localhost:5601

# Public Key Infrastructure & OpenVPN
PKI_DIR=/opt/openvpn-ca
OPENVPN_SERVER=root@10.0.0.1

# SSH Remote Management for Sensors (used when DEMO_MODE=False)
SSH_USER=soc-operator
SSH_TIMEOUT=5
SSH_KEY_PATH=/root/.ssh/id_ed25519

# Local SQLite Database Path
DB_PATH=/app/data/soar.db
